{
  "name": "rwa-vault",
  "version": "0.0.1",
  "private": true,
  "description": "RWA-Vault: A Post-Quantum Anchored Protocol for Tokenised Real-World Assets with Collateralised Micro-Liquidity",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "devnet:up": "docker compose -f infra/docker-compose.yml up -d",
    "devnet:down": "docker compose -f infra/docker-compose.yml down",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vvv",
    "contracts:fmt": "cd contracts && forge fmt --check",
    "contracts:snapshot": "cd contracts && forge snapshot",
    "contracts:deploy:local": "cd contracts && forge script script/Deploy.s.sol --rpc-url http://localhost:8545 --broadcast",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0"
  }
}
