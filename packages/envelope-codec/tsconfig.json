{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src"],
  // Mirrors the workspace:* dependencies in package.json. `tsc --build` follows these
  // edges to compile @rwa-vault/pq-core first, so its declarations exist before this
  // package is checked against them.
  "references": [{ "path": "../pq-core" }]
}
