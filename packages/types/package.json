{
  "name": "@rwa-vault/types",
  "version": "0.0.1",
  "private": true,
  "description": "Shared TypeScript types, including bindings generated from contract ABIs so a contract change surfaces as a compile error rather than a runtime failure.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "typecheck": "tsc --build tsconfig.json",
    "lint": "eslint src",
    "test": "node --test dist/__tests__/onboarding.test.js dist/__tests__/parity.test.js dist/__tests__/onboarding-shared.test.js"
  },
  "devDependencies": {
    "@rwa-vault/config": "workspace:*",
    "ajv": "^8.20.0"
  },
  "files": [
    "dist",
    "schema",
    "fixtures"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/onboarding-input.schema.json": "./schema/onboarding-input.schema.json",
    "./fixtures/onboarding-sentences.json": "./fixtures/onboarding-sentences.json"
  },
  "dependencies": {
    "viem": "2.21.0"
  }
}
