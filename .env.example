# ─────────────────────────────────────────────────────────────────────────────
# Environment variables — RWA-Vault
#
# Copy this file to `.env` and fill in real values. NEVER commit .env.
# (.env is listed in .gitignore in the same commit as this template.)
#
# Variables are grouped by the module or subsystem that consumes them.
# The module identifier (M0–M11) is noted where applicable, matching the
# build plan in docs/RWA-Vault_Module_Build_Plan.docx.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Local devnet (infra/docker-compose.yml) ──────────────────────────────
# These three URLs match the ports exposed by `pnpm devnet:up`.
# If you change a port in docker-compose.yml, update the URL here to match.

# Anvil JSON-RPC endpoint. Chain ID 31337. Pre-funded with 10 accounts
# each holding 10,000 ETH — use account[0] as deployer in local scripts.
ANVIL_RPC_URL=http://localhost:8545

# PostgreSQL connection string. Credentials match the POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_DB values in docker-compose.yml.
# Used by: settlement-rail (M8) double-entry ledger, asset registry (M3).
DATABASE_URL=postgresql://rwa:rwa@localhost:5432/rwa_vault

# Redis connection string. No authentication in local development.
# Used by: oracle → risk-engine → anchor-batcher event bus (Redis Streams),
# client PWA real-time notifications (Redis Pub/Sub).
REDIS_URL=redis://localhost:6379

# ─── Target chain (deployment scripts, M3/M4/M7/M9) ─────────────────────
# Arbitrum Sepolia is the L2 testnet. Mainnet values are added when the
# deployment target is finalised. DEPLOYER_PRIVATE_KEY is the most sensitive
# value here — on a team of three, only the designated deployer needs it.

# RPC endpoint for Arbitrum Sepolia. Use Alchemy, Infura, or a public RPC.
ARBITRUM_SEPOLIA_RPC_URL=

# Private key of the deployer EOA (hex-encoded, no 0x prefix for Foundry).
# NEVER share this. Use a dedicated deployment wallet with limited funds.
DEPLOYER_PRIVATE_KEY=

# Arbiscan API key for `forge verify-contract` source code verification.
ARBISCAN_API_KEY=

# ─── Oracle price sources (M5) ───────────────────────────────────────────
# The oracle aggregation pipeline (services/oracle) polls exactly five
# independent price sources. The diversity constraints from the proposal:
#   - No two sources may share a price origin
#   - No two sources may share an operator
#   - No two sources may share a hosting region
#   - At most two may derive from the same underlying market
#
# These constraints exist because the oracle's security model relies on
# a majority of sources being independent — a correlated failure across
# three sources breaks the median's integrity guarantee.
PRICE_SOURCE_1_URL=
PRICE_SOURCE_2_URL=
PRICE_SOURCE_3_URL=
PRICE_SOURCE_4_URL=
PRICE_SOURCE_5_URL=

# ─── IPFS (M3 document hashes) ───────────────────────────────────────────
# Asset registration (M3) stores valuation documents on IPFS and records
# the content hash on-chain. The gateway URL is for retrieval only —
# pinning is done via a dedicated pinning service.
IPFS_GATEWAY_URL=

# ─── Authentication mode (proposal §VII — control build) ─────────────────
# Two modes exist to support the controlled experiment in the thesis:
#   pq            → post-quantum authentication fabric (Falcon + ML-DSA + SLH-DSA)
#   ecdsa_control → otherwise-identical ECDSA-only build, the measurement baseline
#
# The protocol is functionally identical under both modes. The difference is
# which signature primitives are used. This flag is read by the envelope
# codec (M2) and the key registry contract (M2) to select the correct
# algorithm family. Switching modes is a restart, not a redeployment.
AUTH_MODE=pq

# ─── Feature flags (trunk-based development) ─────────────────────────────
# With three developers on one contract surface, long-lived feature branches
# are a merge-debt risk. Incomplete work ships behind feature flags and is
# enabled once the full module passes its acceptance test.
#
# FEATURE_RESERVE_BUFFER: enables the reserve-buffer solvency cushion (M7).
# FEATURE_LENDING: enables the borrow/repay/liquidate flow (M7).
FEATURE_RESERVE_BUFFER=true
FEATURE_LENDING=false
